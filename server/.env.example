# Credenciales del sandbox que les compartio Plaid
PLAID_CLIENT_ID=tu_client_id_aqui
PLAID_SECRET=tu_secret_de_sandbox_aqui
PLAID_ENV=sandbox

PORT=8080

# Clave para entrar al panel de administrador (elegi la que quieras)
ADMIN_PASSWORD=admin123
# Email del contador para el login unico
ADMIN_EMAIL=contador@bluemaxp.com
# Nombre del contador (aparece en el saludo del panel)
ADMIN_NAME=Contador

# (Opcional) Teller como segunda opcion para conectar el banco (solo EE.UU.).
# El Application ID sale del dashboard de Teller. Sin el, el boton de Teller queda deshabilitado.
TELLER_APPLICATION_ID=
# sandbox (datos simulados), development (bancos reales, hasta 100 conexiones) o production
TELLER_ENV=sandbox
# Solo para development y production: certificado de cliente que entrega Teller
TELLER_CERT_PATH=
TELLER_KEY_PATH=

# (Opcional) URL publica donde Plaid manda los webhooks de transacciones.
# En local se genera con ngrok, ej: https://xxxx.ngrok-free.app/api/webhook
# Si la dejas vacia, el demo funciona igual pero sin actualizaciones automaticas.
PLAID_WEBHOOK_URL=
