# Credenciales del sandbox que les compartio Plaid
PLAID_CLIENT_ID=tu_client_id_aqui
PLAID_SECRET=tu_secret_de_sandbox_aqui
PLAID_ENV=sandbox

PORT=8080

# Clave para entrar al panel de administrador (elegi la que quieras)
ADMIN_PASSWORD=admin123

# (Opcional) URL publica donde Plaid manda los webhooks de transacciones.
# En local se genera con ngrok, ej: https://xxxx.ngrok-free.app/api/webhook
# Si la dejas vacia, el demo funciona igual pero sin actualizaciones automaticas.
PLAID_WEBHOOK_URL=
